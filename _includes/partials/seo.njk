<title>{{ title or metadata.title }}</title>
<meta name="title" content="{{ (title or metadata.title) | escape }}" />
<meta name="description" content="{{ (description or metadata.description) | escape }}" />
<meta name="referrer" content="strict-origin-when-cross-origin">
{% set canonicalUrl = metadata.url ~ page.url %}
{% set isEpisode = "episodes" in (tags or []) %}
{% set publishedDate = publishDate or page.date %}
{% set episodeAuthors = citationAuthors or authors or ["Steven T. Newcomb", "Peter d’Errico"] %}
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ (title or metadata.title) | escape }}" />
<meta property="og:site_name" content="{{ (title or metadata.title) | escape }}" />
<meta property="og:description" content="{{ (description or metadata.description) | escape }}" />
<meta property="og:image" content="{{metadata.url}}{{ metadata.opengraph or metadata.image or image }}" />
<meta property="og:locale" content="{{ metadata.locale }}" />
<meta name="facebook:image" content="{{metadata.url}}{{ metadata.opengraph or metadata.image or image }}" />
<meta property="facebook:description" content="{{ (description or metadata.description) | escape }}" />
<meta property="facebook:author" content="{{ metadata.metasocial.facebook }}" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ (title or metadata.title) | escape }}" />
<meta name="twitter:description" content="{{ (description or metadata.description) | escape }}" />
<meta name="twitter:image" content="{{ metadata.url }}{{ metadata.opengraph or metadata.image or image }}" />
<meta property="twitter:author" content="{{ metadata.metasocial.twitteruser }}" />
<meta name="twitter:site" content="{{ metadata.metasocial.twitter }}" />

<!-- Dublin Core -->
<meta name="dc.title" content="{{ (title or metadata.title) | escape }}" />
{% if isEpisode %}
{% for author in episodeAuthors %}
<meta name="dc.creator" content="{{ author | escape }}" />
{% endfor %}
<meta name="dc.date" content="{{ publishedDate | xmlDate }}" />
{% else %}
<meta name="dc.creator" content="{{ metadata.author.name }}" />
{% endif %}
<meta name="dc.language" content="{{ metadata.language }}" />

{% if isEpisode %}
<!-- Zotero / Highwire / PRISM -->
<meta property="zotero:itemType" content="podcast" />
{% for author in episodeAuthors %}
<meta name="citation_author" content="{{ author | escape }}" />
{% endfor %}
<meta name="citation_publication_date" content="{{ publishedDate | xmlDate }}" />
<meta name="citation_public_url" content="{{ canonicalUrl }}" />
<meta name="citation_language" content="{{ metadata.language }}" />
{% if doi %}
<meta name="citation_doi" content="{{ doi | escape }}" />
{% endif %}
<meta name="prism.publicationName" content="The Domination Chronicles Podcast" />
<meta name="prism.genre" content="podcast" />
{% endif %}

<!-- Icons -->
<link rel="icon" type="image/x-icon" href="{{ metadata.favicon }}" />
<link rel="icon" type="image/png" sizes="96x96" href="/img/favicon/favicon-96x96.png" />
<link rel="icon" type="image/svg+xml" href="/img/favicon/favicon.svg" />
<link rel="shortcut icon" href="/img/favicon/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Domination Chronicles" />
<link rel="manifest" href="/img/favicon/site.webmanifest" />

<!-- Additional Meta -->
<meta name="fediverse:creator" content="@dominationchronicles@mastodon.social" />
<meta name="atproto:handle" content="{{ metadata.atproto.handle }}" />
<meta name="atproto:did" content="{{ metadata.atproto.did }}" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href="{{ canonicalUrl }}" />
<link rel="me" href="{{ metadata.atproto.profile }}" />
<link rel="me" href="{{ metadata.atproto.did_url }}" />
{% if metadata.atproto.standard_site_publication_uri %}
<link rel="site.standard.publication" href="{{ metadata.atproto.standard_site_publication_uri }}" />
{% endif %}
{% if isEpisode %}
<link rel="site.standard.document" href="{{ atproto.uri or (metadata.atproto.did | standardDocumentUri(page.fileSlug)) }}" />
<link rel="author" href="https://stevennewcomb.com/#person" />
<link rel="author" href="https://peterderrico.substack.com/#person" />
<link rel="cite-as" href="{{ canonicalUrl }}" />
<link rel="type" href="https://schema.org/PodcastEpisode" />
{% if metadata.license %}
<link rel="license" href="{{ metadata.license }}" />
{% endif %}
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ page.url }}metadata.json" />
{% endif %}
<meta name="language" content="{{ metadata.language }}" />
<meta name="locale" content="{{ metadata.locale }}" />
<meta name="generator" content="{{ eleventy.generator }}" />
<link rel="alternate" type="application/atom+xml" href="/feed/feed.xml" title="{{ metadata.title }}" />
<link rel="alternate" type="application/rss+xml" href="/feed/podcast.xml" title="{{ metadata.title }} Podcasting 2.0 Feed" />
<link rel="alternate" type="application/xml" href="/feed/dublin-core.xml" title="{{ metadata.title }} Dublin Core XML" />
<link rel="alternate" type="application/xml" href="/feed/doaj.xml" title="{{ metadata.title }} DOAJ XML" />
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

<!-- Styles and Anchors -->
<style>
{% inlineCSS "css/index.css" %}
{% inlineCSS "css/style.css" %}
</style>
<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>

<!-- Schema.org JSON-LD -->
{% include "partials/jsonld.njk" %}
